{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter @trading/sdk build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @trading/scripts run swap:loop",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
